<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>kr.dogfoot</groupId>
    <artifactId>hwplib</artifactId>
    <packaging>jar</packaging>
    <version>1.2.0</version>

    <name>HWP Library</name>
    <description>The hwp library is a library that can read and write hwp files used in the word processor developed by Hancom.</description>
    <url>https://github.com/neolord0/hwplib</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <licenses>
        <license>
            <name>apache-2.0</name>
            <url>https://opensource.org/licenses/Apache-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/neolord0/hwplib</url>
        <connection>scm:git:git://github.com/neolord0/hwplib.git</connection>
    </scm>

    <developers>
        <developer>
            <email>neolord@hanmail.net</email>
            <name>Park.sungkyon</name>
            <url>https://github.com/neolord0</url>
            <id>neolord0</id>
        </developer>
    </developers>

    <build>
        <plugins>
            <!-- compile -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/sample/**</exclude>
                    </excludes>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <!-- make jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>2.3.2</version>
                <configuration>
                    <excludes>
                        <exclude>**/sample/**</exclude>
                        <exclude>**/*.iml</exclude>
                        <exclude>**/*.hwp</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- maven -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>2.3</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- make javadoc -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <doclint>none</doclint>
                    <additionalOptions>
                        <additionalOption>-html5</additionalOption>
                    </additionalOptions>
                    <failOnError>false</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- 기본 배포 대상: GTOne Nexus (mvn deploy). Maven Central 배포는 -P central 프로파일 사용. -->
    <distributionManagement>
        <repository>
            <id>gtone-maven-releases</id>
            <name>GTOne Releases</name>
            <url>https://nexus.gtonesoft.com/repository/gtone-maven-releases/</url>
        </repository>
        <snapshotRepository>
            <id>gtone-maven-snapshots</id>
            <name>GTOne Snapshots</name>
            <url>https://nexus.gtonesoft.com/repository/gtone-maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <repositories>
        <repository>
            <id>gtone-public</id>
            <name>GTOne Public repository</name>
            <url>https://nexus.gtonesoft.com/repository/maven-public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
